#!/usr/bin/env bash
#
# Shared pre-push gate: `composer ci:check` (static checks, vitest, Unit, Feature
# and Browser suites), kept out of pre-commit so committing stays fast. The
# Contract suite is not part of it. Runs for everyone.
#
# Enable once per clone:  git config core.hooksPath .githooks
#
set -euo pipefail

# Own Playwright state file, so a hook run can't delete the one a manual test run reads.
PEST_BROWSER_STATE_FILE="$(mktemp -d)/playwright-server.json"
export PEST_BROWSER_STATE_FILE
trap 'rm -rf "$(dirname "$PEST_BROWSER_STATE_FILE")"' EXIT

echo "▶ run checks and tests"
composer ci:check
echo "✓ checks and tests passed"
