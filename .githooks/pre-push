#!/usr/bin/env bash
#
# Shared pre-push gate: `composer ci:check` (static checks, vitest, Unit, Feature
# and Browser suites), kept out of pre-commit so committing stays fast. The
# Contract suite is not part of it. Runs for everyone.
#
# Enable once per clone:  git config core.hooksPath .githooks
#
set -euo pipefail

echo "▶ run checks and tests"
composer ci:check
echo "✓ checks and tests passed"
