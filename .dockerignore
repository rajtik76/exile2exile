# Restored inside the image by composer install, npm ci and npm run build.
/vendor/
/node_modules/
/public/build/
/public/hot
/resources/js/actions/
/resources/js/routes/
/resources/js/wayfinder/

# Extractor state. Its dependencies are installed in the image; the cache and
# output are regenerated by the first extraction.
/tools/poe-data-extract/node_modules/
/tools/poe-data-extract/.cache/
/tools/poe-data-extract/out/
/tools/poe-data-extract/tables/
/tools/poe-data-extract/files/
/tools/poe-data-extract/config.json

# Game data lives in the persistent volume and is symlinked in at boot.
/public/icons/
/public/tree/
/resources/poe2/ggpk
/storage/game-data/

# Credentials. Coolify hands the container its environment at run time.
.env
.env.*
!.env.example
auth.json

# Local runtime state. The directories themselves have to stay: artisan needs
# them to boot.
/bootstrap/cache/*.php
/storage/logs/*.log
/storage/framework/cache/data/**
/storage/framework/sessions/*
/storage/framework/views/*.php
/storage/pail/

# Tooling and editor state.
/.git/
/.github/
/.githooks/
/.idea/
/.vscode/
/coverage/
.DS_Store

# Not used at runtime.
/docs/
/docs-internal/
/tests/
/phpunit.xml
/phpstan.neon
/rector.php
